				"id": "ghost_girl",
				"name": "幽灵娘",
				"tex": "res://assets/image/怪物_幽灵娘v3_20260426072315.png",
				"dialogue": [
					{ "speaker": "幽灵娘", "text": "……你在找什么？" },
					{ "speaker": "幽灵娘", "text": "她留下过很多东西，散落在各个角落里……" },
