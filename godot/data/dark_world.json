	"npcs": {
		"0": [
			{
				"id": "nekomata",
				"name": "双尾猫妖",
				"tex": "res://assets/image/怪物_双尾猫妖v3_20260426071805.png",
				"dialogue": [
					{ "speaker": "双尾猫妖", "text": "喵~你也迷路了吗？这里的巷子会自己改变方向的……" },
					{ "speaker": "双尾猫妖", "text": "小心那些飘来飘去的家伙，它们可不像我这么友好。" },
					{ "speaker": "双尾猫妖", "text": "要是走不动了就回去吧，反正下次来还是这条路。" }
