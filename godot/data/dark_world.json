	"elite_encounter": {
		"_comment": "精英守卫遭遇 — 满足条件时在暗面探索中触发",
		"conditions": {
			"min_fragments": 4,
			"requires_baiye_follow": true,
			"requires_clue_card": true,
			"not_flag": "elite_defeated"
		},
		"dialogue": [
			{ "speaker": "???", "text": "一个巨大的影子挡住了去路……它似乎在守护着什么。" },
			{ "speaker": "白夜", "text": "……它认出我了。那是深渊的守门者。" },
			{ "speaker": "白夜", "text": "如果你愿意的话……我可以用这张线索卡换取通行权。但代价是你所有的力量。" }
		],
		"choices": [
			{
				"label": "让白夜进行交涉（蜕变）",
				"effects": {
					"set_flags": { "elite_defeated": true },
					"set_power": 0,
					"add_sleep_days": 3,
					"add_fragment": "frag_05"
				},
				"result_text": "白夜向守门者展示了线索卡，一阵耀眼的光芒之后……你失去了所有力量，但获得了一枚珍贵的碎片。接下来三天你需要休息。"
			},
			{
				"label": "先撤退",
				"effects": {},
				"result_text": "你决定暂时撤退，守门者没有追来。"
			}
		]
	},

	"boss_encounter": {
		"_comment": "深渊Boss遭遇 — 在最深处/深渊核心附近满足条件时触发",
		"conditions": {
			"min_fragments": 9,
			"requires_baiye_follow": true,
			"requires_abyss_core": true,
			"not_flag": "boss_defeated"
		},
		"dialogue": [
			{ "speaker": "???", "text": "深渊的核心在脉动……一个不可名状的存在从黑暗中浮现。" },
			{ "speaker": "白夜", "text": "这就是……记忆的守护者。我们收集的碎片足够了。" },
			{ "speaker": "白夜", "text": "与它对峙会很危险，但如果成功……所有的记忆都会回来。" }
		],
		"choices": [
			{
				"label": "与记忆守护者对峙",
				"effects": {
					"set_flags": { "boss_defeated": true, "memory_complete": true },
					"san": -3,
					"add_fragment": "frag_10"
				},
				"result_text": "一场惊心动魄的对峙之后……记忆守护者崩解了。最后一枚碎片落入手中，所有碎片开始共鸣。你失去了3点理智，但所有记忆已经完整。"
			},
			{
				"label": "还没准备好",
				"effects": {},
				"result_text": "你后退了一步，深渊的黑暗重新将一切吞没。下次再来吧。"
			}
		]
	},

